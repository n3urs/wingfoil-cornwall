# Copy to .env and paste your key in.
#
# Free UKHO ADMIRALTY UK Tidal API "Discovery" key:
#   1. Register at https://developer.admiralty.co.uk
#   2. Products -> UK Tidal API - Discovery -> Subscribe (free, 10k calls/month)
#   3. Copy the Primary key from your Profile page
#
# Without this the dashboard still works — it derives tides from Open-Meteo's
# modelled sea level instead, which is close but not official.
ADMIRALTY_API_KEY=
